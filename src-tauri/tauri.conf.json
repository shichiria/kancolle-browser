{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KanColle Browser",
  "version": "0.5.3",
  "identifier": "com.eo.kancolle-browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "management",
        "title": "KanColle Browser",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "kantai",
        "title": "KanColle Browser - 艦隊",
        "width": 600,
        "height": 900,
        "minWidth": 400,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "quests",
        "title": "KanColle Browser - 任務",
        "width": 800,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400,
        "visible": false
      },
      {
        "label": "improvement",
        "title": "KanColle Browser - 改修",
        "width": 1100,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false
      },
      {
        "label": "ships",
        "title": "KanColle Browser - 艦娘",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false
      },
      {
        "label": "event",
        "title": "KanColle Browser - イベント",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 500,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
